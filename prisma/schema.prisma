// Prisma schema for Mi Proceso - Hackathon Norte Potencia
// Based on REQUERIMIENTOS_MI_PROCESO.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum CaseStatus {
  EN_INICIO
  EN_REVISION
  ASIGNADO_A_FISCAL
  PERITAJE_EN_PROCESO
  AUDIENCIA_PROGRAMADA
  EN_JUICIO
  RESOLUCION
  ARCHIVO
}

enum CaseType {
  VIOLENCIA_GENERO
  DELITO_COMUN
  ACCIDENTE
  PROPIEDAD
  OTRO
}

enum EventStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  BLOQUEADO
}

enum Institution {
  POLICIA
  MINISTERIO
  JUZGADO
  DEFENSORIA
}

enum DocumentType {
  DENUNCIA
  PRUEBA
  IDENTIFICACION
  TESTIMONIO
  PERITAJE
  RESOLUCION
  OTRO
}

enum DocumentStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
  REQUIERE_CORRECCION
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  googleId      String?   @unique
  calendarToken String?   // encrypted
  calendarRefreshToken String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases         Case[]
}

model Case {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identificación
  caseNumber      String    @unique
  trackingCode    String    @unique @default(cuid())

  // Estado
  status          CaseStatus @default(EN_INICIO)
  type            CaseType

  // Datos de la denuncia
  title           String
  description     String    @db.Text
  incidentDate    DateTime?

  // Modo Incógnito
  anonymousMode   Boolean   @default(false)

  // timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  timeline        TimelineEvent[]
  documents       Document[]
  institutions    CaseInstitution[]
  feedbacks       Feedback[]
}

model TimelineEvent {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  date        DateTime
  title       String
  description String?   @db.Text
  status      EventStatus
  institution Institution

  createdAt   DateTime  @default(now())
}

model Document {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name        String
  url         String
  type        DocumentType
  institution Institution

  status      DocumentStatus @default(PENDIENTE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CaseInstitution {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  institution Institution
  status      String    // pending, reviewing, approved, rejected

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Feedback {
  id          String    @id @default(cuid())
  caseId      String?
  case        Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  // Datos anónimos
  institution Institution

  // Calificaciones (1-5)
  respectRating     Int
  listeningRating   Int
  clarityRating     Int

  // Comentarios
  comments    String?   @db.Text

  createdAt   DateTime  @default(now())
}